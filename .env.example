# ─── Database (Neon Postgres) ──────────────────────────────────────────────
# Pooled connection string (host contains "-pooler") — used by the app at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/vyhel?sslmode=require
# Direct (non-pooled) connection string — used for migrations, seeding and admin scripts.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/vyhel?sslmode=require
# Optional: connections per server instance (default 5)
# DATABASE_POOL_MAX=5

# ─── Site ──────────────────────────────────────────────────────────────────
# Public base URL, used for canonical URLs, sitemap, Open Graph and links in emails.
# Local: http://localhost:3000   Production (Vercel): https://vyhel.co.in
# It is baked in at build time, so set it in Vercel BEFORE deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Media storage (optional) ──────────────────────────────────────────────
# If set, uploads go to Vercel Blob. If empty, images are stored in Postgres and served from /media/[id].
BLOB_READ_WRITE_TOKEN=

# ─── Razorpay (DIGITAL products only) ──────────────────────────────────────
# Dashboard → Account & Settings → API Keys. Use test keys (rzp_test_…) until you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret you choose. URL: https://YOUR_DOMAIN/api/payments/razorpay/webhook
# Events: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Vyhel <orders@vyhel.co.in>".
# "Vyhel <onboarding@resend.dev>" (the fallback) ONLY delivers to your own Resend account email —
# customers will never receive their download with it.
EMAIL_FROM=Vyhel <orders@vyhel.co.in>
# Resend → Webhooks signing secret ("whsec_…"), for bounce/delivery tracking at /api/email/resend/webhook.
RESEND_WEBHOOK_SECRET=
# Where new-sale notifications go.
ADMIN_EMAIL=

# ─── Private storage for digital product files (optional) ──────────────────
# Leave empty to store files in Postgres (fine for files up to a few MB).
# For bigger files use a PRIVATE S3-compatible bucket, e.g. Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Amazon Associates ─────────────────────────────────────────────────────
# Default Associate ID (e.g. yourtag-21). Admin → Settings → "Amazon Associate ID" overrides it.
# Vyhel never rewrites links: paste Amazon's Special Link (it already contains ?tag=); this value
# is used to warn when a pasted link's tag doesn't match.
AMAZON_ASSOCIATE_TAG=
# Reserved for a future, server-side, Amazon-approved product data integration. Never expose client-side.
AMAZON_API_KEY=
AMAZON_API_SECRET=

# ─── Admin bootstrap (scripts only) ─────────────────────────────────────────
# Used only by `npm run admin:create` if you don't want to type the password interactively.
# ADMIN_PASSWORD=

# ─── TEST ONLY — never set these on Vercel ──────────────────────────────────
# Point Razorpay/Resend at a local mock server for `npm run test:e2e`.
# They are ignored on a Vercel production deployment (VERCEL_ENV=production).
# RAZORPAY_API_BASE=http://localhost:4010
# RESEND_API_BASE=http://localhost:4010
